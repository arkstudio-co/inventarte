# Este es el arnes portable: solo viaja lo que se copia a un proyecto nuevo.

# worktrees de features: cada uno es una copia completa del arbol (docs/worktrees.md)
/.worktrees/

# dependencias (si alguna vez se instala algo aca)
node_modules/

# variables de entorno: nunca. La plantilla si, si algun dia existe.
.env
.env.*
!.env.example

# config local de maquina, no del arnes
.claude/settings.local.json

# ruido del SO y logs
.DS_Store
*.log

# artefactos de build y generados (TS6: .next/, coverage/, playwright-report/, test-results/)
.next/
coverage/
playwright-report/
test-results/
lib/generated/
*.tsbuildinfo

# declaracion TypeScript regenerada por `next dev`/`next build` (docs de Next 16: no versionar)
next-env.d.ts

# reporte transitorio del gate (test:json -> scripts/comparar-baseline-rojos.mjs)
.vitest-rojos.json
