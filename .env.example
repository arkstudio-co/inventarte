# Copia este archivo a .env y rellena los valores reales. NUNCA se versionan valores reales.
# El gate e init.sh cargan .env; SUS valores no viven en git (docs/architecture.md).

# La base necesita DOS cadenas (docs/architecture.md > Acceso a datos y autorizacion):
#   DATABASE_URL -> pooler (pgbouncer, puerto 6543): la consume la app en runtime.
#   DIRECT_URL   -> conexion directa (puerto 5432): la usa Prisma Migrate (prisma.config.ts
#                   datasource.url). Sin directUrl las migraciones fallan con errores que no
#                   apuntan a la causa.
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:6543/BASE?pgbouncer=true"
DIRECT_URL="postgresql://USUARIO:CLAVE@HOST:5432/BASE"

# Secreto de firma del token de sesion: minimo 32 caracteres (design.md; R11 — el token se
# firma con HMAC-SHA-256 via WebCrypto y el modulo lee el secreto en cada llamada, fallando
# cerrado si falta o es corto). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="REEMPLAZA_ESTE_VALOR_POR_UN_SECRETO_DE_AL_MENOS_32_CARACTERES_0123456789"

# Politica de bloqueo del login (design.md; los parsea la composicion en T13, fail-fast:
# valor invalido -> throw al arrancar).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES="1,5,15,60"